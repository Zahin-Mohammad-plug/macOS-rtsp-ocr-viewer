# Copy to .env and fill in your values. .env is gitignored.
# Used by development docs and test scripts (e.g. Smart Pause validation).

# Path to a local test video. The app is sandboxed: use a file under ~/Movies,
# ~/Downloads, or ~/Library/Containers/com.sharpstream.SharpStream/Data/tmp/
SHARPSTREAM_TEST_VIDEO_FILE=

# Optional: RTSP URL for live-stream tests (e.g. a MediaMTX camera: rtsp://<host>:8554/cam)
SHARPSTREAM_TEST_RTSP_URL=

